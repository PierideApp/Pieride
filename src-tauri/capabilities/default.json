{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-allow-instance",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-sql-batch",
    "sql:allow-select",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [],
      "deny": [{ "url": "http://*" }]
    }
  ]
}
