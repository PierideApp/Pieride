{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pieride",
  "mainBinaryName": "pieride",
  "version": "../package.json",
  "identifier": "io.github.pierideapp.pieride",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "$CONFIG/Pieride",
    "windows": [
      {
        "label": "main",
        "title": "Piéride",
        "width": 1280,
        "height": 720,
        "minWidth": 720,
        "decorations": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QkQ3MTk4NjYwREVDOUIKUldTYjdBMW1tSEc5aHRqbnVBQ2pXdERLdVU1RlZ6VWJsbk4wRE9GbENuZE5VbEhGVzMvUG9YVlUK",
      "endpoints": [
        "https://github.com/PierideApp/Pieride/releases/latest/download/latest.json"
      ]
    },
    "http": {
      "scopeRedirects": true
    }
  }
}
