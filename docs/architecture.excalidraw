      "boundElements": [],
      "updated": 1792500000000,
      "link": null,
      "locked": false,
      "text": "Repris des plugins de Papillon. Chaque service déclare ses capabilities ; l'AccountManager ne lui demande que celles-là.",
      "originalText": "Repris des plugins de Papillon. Chaque service déclare ses capabilities ; l'AccountManager ne lui demande que celles-là.",
