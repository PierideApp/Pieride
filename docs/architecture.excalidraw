    },
    {
      "id": "i2wZvn6tCnReae6NoIooF",
      "type": "rectangle",
      "x": 0,
      "y": 3260,
      "width": 1480,
      "height": 250,
      "angle": 0,
      "strokeColor": "#f08c00",
