      "locked": false,
      "text": "Règles de sécurité",
      "originalText": "Règles de sécurité",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JkJGkaZgxzL4wCbx5bBJb",
      "type": "rectangle",
      "x": 1580,
      "y": 3260,
      "width": 1490,
      "height": 250,
      "angle": 0,
      "strokeColor": "#e03131",
